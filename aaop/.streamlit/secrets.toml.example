# Copy this file to .streamlit/secrets.toml for local Streamlit Cloud testing.
# On Streamlit Cloud: paste these as key=value in the app's Secrets section.
#
# NEVER commit secrets.toml — it is in .gitignore.

STREAMLIT_CLOUD = "true"
GROQ_API_KEY    = "gsk_..."          # required — free at console.groq.com/keys
ANTHROPIC_API_KEY = ""               # optional paid fallback
OPENAI_API_KEY    = ""               # optional paid fallback

# Set by the entry-point file (dev_app.py / uat_app.py / prod_app.py).
# Only needed here if you're pointing Streamlit Cloud directly at app.py.
# AAOP_ENV = "dev"
